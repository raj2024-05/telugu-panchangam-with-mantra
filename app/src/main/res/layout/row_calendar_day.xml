<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@color/gold_card"
    android:layout_marginBottom="2dp"
    android:layout_marginHorizontal="4dp">

    <TextView
        android:id="@+id/tvDayNum"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/text_red"
        android:gravity="center"
        tools:text="08"
        xmlns:tools="http://schemas.android.com/tools"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/tvDayTithi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="13sp"
            tools:text="త్రయోదశి, కృష్ణ పక్షం"
            xmlns:tools="http://schemas.android.com/tools"/>

        <TextView
            android:id="@+id/tvDayNakshatra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/maroon_dark"
            android:textSize="12sp"
            tools:text="పుష్యమి • మంగళవారం"
            xmlns:tools="http://schemas.android.com/tools"/>
    </LinearLayout>
</LinearLayout>
