<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/maroon_primary"
        app:title="@string/feat_shodasha_varga"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/etYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="జననం సంవత్సరం (ఉదా. 1995)"
                android:inputType="number" />

            <EditText
                android:id="@+id/etMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="నెల (1-12)"
                android:inputType="number"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="రోజు (1-31)"
                android:inputType="number"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etHour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="గంట (0-23, స్థానిక సమయం)"
                android:inputType="number"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etMinute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="నిమిషం (0-59)"
                android:inputType="number"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="అక్షాంశం (ఉదా. 17.385)"
                android:inputType="numberDecimal|numberSigned"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etLon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="రేఖాంశం (ఉదా. 78.4867)"
                android:inputType="numberDecimal|numberSigned"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="చార్ట్ ఎంచుకోండి (Rashi / Bhava / Navamsa / షోడశ వర్గములు)"
                android:textColor="@color/text_red"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/gold_card"
                android:spinnerMode="dropdown"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnCompute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="చార్ట్ చూపించు"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/maroon_primary"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
